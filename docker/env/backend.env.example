APP_ENV=development
APP_TIMEZONE=Asia/Tokyo
PORT=8080

DB_HOST=db
DB_PORT=5432
DB_USER=fitlog
DB_PASSWORD=
DB_NAME=fitlog

FRONTEND_URL=http://localhost:3000

# 32 bytes以上のランダム値に必ず置き換えてください。
SESSION_SECRET=
SESSION_COOKIE_NAME=fitlog_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=720

OPENAI_API_KEY=
OPENAI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
OPENAI_MODEL=gemini-2.5-flash
AI_RATE_LIMIT_RPM=5
AI_RATE_LIMIT_MAX_WAIT_MS=15000
AI_MAX_ATTEMPTS=3
AI_HTTP_TIMEOUT_SECONDS=30
AI_RETRY_BASE_MS=500
AI_RETRY_MAX_MS=5000

PROMPT_DIR=prompts
