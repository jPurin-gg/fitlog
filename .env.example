# 環境変数の全項目一覧（実キー・実パスワードは記載しない）。
# デプロイ先で .env にコピーし、必須項目を固有の値に置き換えてください。
# .env はComposeの変数展開用です。コンテナへの受け渡し手順はREADMEの「本番環境」を参照。
# 「任意」は既定値あり、または機能利用時のみ必要な項目です。

# --- 公開URL・内部通信・ホスト公開設定（任意） ---
# ブラウザに公開されるAPI URL。空欄は同一オリジンの /api 中継を使う（既定）。秘密情報は禁止。
# 別オリジンなら公開APIのURLを指定。変更後はフロントエンドの再ビルドが必要。
NEXT_PUBLIC_API_URL=
# Next.jsの中継先。Composeでは以下が既定、ホスト単独実行では http://localhost:8080。
BACKEND_INTERNAL_URL=http://backend:8080
# 本番Composeの待ち受け先。リバースプロキシを同一ホストで動かす場合の既定値。
FRONTEND_HOST=127.0.0.1
# フロントエンドのホスト側公開ポート（既定3000）。
FRONTEND_PORT=3000
# バックエンドのホスト側公開アドレス（既定127.0.0.1）。
BACKEND_HOST=127.0.0.1
# バックエンドのホスト側公開ポート（既定8080）。PORTとは別の設定。
BACKEND_PORT=8080

# --- PostgreSQL初期化（必須、本番用の値に置換） ---
# DB初回作成時のユーザー名。DB_USERとそろえる。
POSTGRES_USER=change-me
# DB初回作成時の強い固有パスワード。DB_PASSWORDとそろえる。
POSTGRES_PASSWORD=change-me
# DB初回作成時のDB名。DB_NAMEとそろえる。
POSTGRES_DB=change-me
# 既存ボリュームのユーザー・パスワード・DB名は、これらの値を変えるだけでは変更されない。

# --- バックエンドDB接続 ---
# 任意: 接続先ホスト（既定db）。
DB_HOST=db
# 任意: コンテナ内のDBポート（既定5432）。
DB_PORT=5432
# 必須: POSTGRES_USERと同じDBユーザー。
DB_USER=change-me
# 本番必須: POSTGRES_PASSWORDと同じパスワード。コード上は空欄でも検証されない。
DB_PASSWORD=change-me
# 必須: POSTGRES_DBと同じDB名。
DB_NAME=change-me

# --- バックエンド・認証 ---
# 必須: 32 bytes以上のランダム値をデプロイ先で生成（例: openssl rand -base64 48）。
# 以下はダミー。生成した実値はGitに入れない。
SESSION_SECRET=change-me-generate-at-least-32-random-bytes
# 任意: 実行環境名（コードの既定development、本番はproduction）。
APP_ENV=production
# 任意: バックエンドのコンテナ内ポート（既定8080）。Compose利用時は変更不要。
PORT=8080
# 任意: CORSで許可するWebアプリのオリジン（既定http://localhost:3000）。
# 本番では https://fitlog.example.com など実際の公開オリジンに変更する。
FRONTEND_URL=http://localhost:3000
# 任意: 日付判定に使うIANAタイムゾーン（既定Asia/Tokyo）。
APP_TIMEZONE=Asia/Tokyo
# 任意: 認証Cookie名（既定fitlog_session）。
SESSION_COOKIE_NAME=fitlog_session
# 本番HTTPSでは必須true。コードの既定false、ローカルHTTPではfalseにする。
SESSION_COOKIE_SECURE=true
# 任意: セッション有効期間（時間、既定720 = 30日）。
SESSION_TTL_HOURS=720
# 任意: プロンプトディレクトリ（既定prompts、コンテナの /app 基準）。
PROMPT_DIR=prompts

# --- AI Provider: 現行xAI（AI利用時のみ必要） ---
# 任意: xAI Consoleで発行するAPIキー。未設定でも記録用サーバーは起動できる。
# 空欄のままならAIは利用不可。実キーはデプロイ先の秘密ファイルだけに置く。
XAI_API_KEY=
# 任意: Chat Completionsエンドポイント（コードの既定値）。
XAI_API_URL=https://api.x.ai/v1/chat/completions
# 任意: 利用モデル（コードの既定値）。利用可能なモデルはxAI Consoleで確認する。
XAI_MODEL=grok-4.3

# --- AI調整（任意、現行コードの既定値） ---
# プロセス内の毎分リクエスト上限。
AI_RATE_LIMIT_RPM=5
# レート制限の最大待機時間（ミリ秒）。
AI_RATE_LIMIT_MAX_WAIT_MS=15000
# リトライを含む最大試行回数（1〜3に制限）。
AI_MAX_ATTEMPTS=3
# AI HTTPクライアントのタイムアウト（秒）。
AI_HTTP_TIMEOUT_SECONDS=30
# 日次調整・次セット提案・総評の待機上限（秒）。
AI_OPTIONAL_TIMEOUT_SECONDS=15
# リトライ待機の初期値（ミリ秒）。
AI_RETRY_BASE_MS=500
# リトライ待機の最大値（ミリ秒）。
AI_RETRY_MAX_MS=5000

# --- 今後の多Provider対応（#1〜#7）用（任意・現行コードでは未使用） ---
# 設定契約の予約項目。実装前に有効化しないよう全項目をコメントアウトする。
# 将来: 順序はカンマ区切り。識別子は cerebras,groq,openrouter,xai。
# 順序と新Providerキーが全て未設定なら従来のxAI単独動作を維持する。
# 新キーまたは順序の指定で複数Providerモード。順序未指定はCerebras→Groq→OpenRouter Free。
# キーなし候補は除外し、候補0件でも記録用サーバーは起動可。xAI単独へ暗黙には戻らない。
# 複数ProviderモードでxAIを使う場合は順序にxaiを明示する。有料経路に自動切替しない。
# AI_PROVIDER_ORDER=cerebras,groq,openrouter
# 任意: Cerebrasの開発者コンソールで発行するキー（利用時のみ必要）。
# CEREBRAS_API_KEY=
# 任意: Cerebras公式仕様で確認するChat Completions URL（既定値は未確定）。
# CEREBRAS_API_URL=
# 任意: Cerebrasで利用可能なモデル（導入時に無料枠・有料化条件も確認）。
# CEREBRAS_MODEL=
# 任意: Groq Consoleで発行するキー（利用時のみ必要）。
# GROQ_API_KEY=
# 任意: Groq公式仕様で確認するChat Completions URL（既定値は未確定）。
# GROQ_API_URL=
# 任意: Groqで利用可能なモデル（導入時に無料枠・有料化条件も確認）。
# GROQ_MODEL=
# 任意: OpenRouterのAPI Keys画面で発行するキー（利用時のみ必要）。
# OPENROUTER_API_KEY=
# 任意: OpenRouter公式仕様で確認するChat Completions URL（既定値は未確定）。
# OPENROUTER_API_URL=
# 任意: 無料ルーティングを使う設定例。導入時に公式仕様・料金条件を再確認する。
# OPENROUTER_MODEL=openrouter/free
# 任意: 1回の処理で試すProvider数の上限（既定値は未確定）。
# AI_FALLBACK_MAX_PROVIDERS=
# 任意: 全Providerを通した総試行回数の上限（既定値は未確定）。
# AI_FALLBACK_MAX_TOTAL_ATTEMPTS=
# 任意: 全Providerを通した総タイムアウト（秒、既定値は未確定）。
# AI_FALLBACK_TOTAL_TIMEOUT_SECONDS=

# --- 開発・検証専用（任意、本番では不要） ---
# Next.js開発時のファイル監視。開発Composeがtrueを設定する。
# WATCHPACK_POLLING=true
# Node.js実行モード。本番Dockerfileがproductionを設定するため手動設定不要。
# NODE_ENV=production
# Go統合テストの接続DSN。compose.test.ymlが専用DB用の値を設定する。
# ホスト実行時の既定接続先は127.0.0.1:55432。本番DBには接続しない。
# FITLOG_TEST_DATABASE_DSN=
# Playwright起動ポート（既定3000）。ホストのシェルで指定する（.envの自動読込なし）。
# E2E_PORT=3000
# Playwrightのブラウザチャネル（既定は同梱Chromium、例: chrome）。
# PLAYWRIGHT_CHANNEL=
# PlaywrightのCIモード（未設定が既定、非空文字列で有効。falseでも有効になる）。
# CI=
