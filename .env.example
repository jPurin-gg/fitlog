# compose.prod.yml の変数展開に使うファイルです。
# デプロイ先で `.env.example` を `.env` にコピーして、本番値に書き換えてください。

# フロントエンドのビルド時に埋め込まれる、公開バックエンドAPIのURLです。
# 例: https://api.fitlog.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# リバースプロキシや Cloudflare Tunnel を同じホストで動かす場合は 127.0.0.1 のままでOKです。
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
