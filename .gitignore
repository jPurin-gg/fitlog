# 実際の環境変数ファイルは機密情報を含むのでコミットしない
docker/env/*
!docker/env/
!docker/env/*.env.example
frontend/node_modules/
frontend/.next/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
backend/fitlog
backend/tmp/

# ルートの .env / .env.prod もコミットしない
.env
.env.*
!.env.example
!*.env.example

# 開発・移行用の不要ファイル群（other/ フォルダ）
other/
